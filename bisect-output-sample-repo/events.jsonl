{"type": "culprit", "index": 26, "hash": "2dfbf08ef22866f3a7dcb9cad81f64c48ea6ac97", "short": "2dfbf08", "message": "refactor: simplify discount helpers", "diff": "diff --git a/shop/discounts.py b/shop/discounts.py\nindex 86ce6b9..09bfcf8 100644\n--- a/shop/discounts.py\n+++ b/shop/discounts.py\n@@ -3,11 +3,20 @@\n All amounts are in dollars, rounded to cents.\n \"\"\"\n \n-BULK_THRESHOLD = 10   # buy 10 or more of one item -> bulk discount\n+BULK_THRESHOLD = 10   # buy more than 10 of one item -> bulk discount\n BULK_RATE = 0.10\n+COUPON_CAP = 50.0\n+\n+\n+def _pct(amount, rate):\n+    return round(amount * rate, 2)\n \n \n def bulk_discount(qty, unit_price):\n-    if qty >= BULK_THRESHOLD:\n-        return round(qty * unit_price * BULK_RATE, 2)\n+    if qty > BULK_THRESHOLD:\n+        return _pct(qty * unit_price, BULK_RATE)\n     return 0.0\n+\n+\n+def coupon_discount(subtotal, percent):\n+    return min(_pct(subtotal, percent / 100.0), COUPON_CAP)", "t": 1.21}
